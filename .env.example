# Preço do acesso em reais
PMESP_PRICE=47
# (Opcional) Nome do produto no checkout
PMESP_PRODUCT_NAME=Missão PMESP — Simulados e Guia do Edital
# Wiven (Pix com QR Code no próprio site) — painel Wiven > Integrações > API > Gerar credenciais.
# Com estas duas preenchidas, a Wiven passa a ser o pagamento usado (tem prioridade sobre o Mercado Pago).
WIVEN_PUBLIC_KEY=
WIVEN_SECRET_KEY=
# (Opcional) 1 = pedir CPF na compra. Use se a Wiven recusar cobranças sem documento.
PMESP_PEDIR_CPF=
# Mercado Pago (Pix, cartão e boleto): Seu negócio > Configurações > Credenciais > Access Token de PRODUÇÃO
MERCADOPAGO_ACCESS_TOKEN=
# (Alternativa) Link de checkout externo (Hotmart, Kiwify...). As vendas são liberadas em /admin.
PMESP_CHECKOUT_URL=
# Senha do painel /admin (vendas e liberação de acesso)
ADMIN_PASSWORD=
# Segredo para assinar o login dos alunos (texto longo e aleatório)
PMESP_SESSION_SECRET=
# Modo demonstração: libera acesso sem pagar enquanto não há checkout. APAGUE antes de vender.
PMESP_DEMO=
# (Opcional) Endereço público do site
NEXT_PUBLIC_SITE_URL=
# Banco: na Vercel, Storage > Blob (Private) > Connect cria BLOB_READ_WRITE_TOKEN sozinho
