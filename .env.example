# Número do WhatsApp que recebe os leads (só dígitos, com DDI 55 + DDD). Ex: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Mensagem que já vem escrita no WhatsApp. {nome} é trocado pelo primeiro nome do lead.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Oi! Sou {nome} e quero entrar na lista secreta da Marcha no Tráfego 🔒

# (Opcional) Data/hora da abertura — liga a contagem regressiva. Formato ISO com fuso.
NEXT_PUBLIC_LAUNCH_DATE=2026-11-20T20:00:00-03:00

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Banco de dados (Upstash Redis). Na Vercel: Storage > Upstash for Redis > Connect,
# que cria KV_REST_API_URL e KV_REST_API_TOKEN automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
